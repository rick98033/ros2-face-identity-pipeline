# Request
float32 max_age_sec    # Window size (clamped to server retention_sec)
bool latest_only       # If true, ignore max_age_sec and return only latest frame
---
# Response
bool success
string error
builtin_interfaces/Time timestamp    # Server time of snapshot
thor_msgs/PersonState[] people       # Current people in view
uint32 total_frames_in_window        # Frames aggregated
float32 window_used_sec              # Actual window used (may be < max_age_sec if clamped)
